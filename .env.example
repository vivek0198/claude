NODE_ENV=development
PORT=3000
# Public URL of the frontend/app, used to build links in emails
APP_URL=http://localhost:3000

# MySQL (XAMPP defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=claude_code_app

# JWT - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Block login until the email address is verified
REQUIRE_EMAIL_VERIFICATION=true

# SMTP - leave SMTP_HOST empty to print emails to the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="My App <no-reply@example.com>"
