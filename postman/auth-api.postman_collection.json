    {
      "name": "Auth",
      "description": "Register, sign in, refresh, sign out and the current user.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"registerEmail\", `user${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test(\"Email is not verified yet\", () => pm.expect(pm.response.json().user.emailVerified).to.be.false);",
                  "pm.collectionVariables.set(\"targetUserId\", pm.response.json().user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"New User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates an account with role `user` and sends a verification email (printed in the server console without SMTP). The pre-request script picks a fresh random email each time."
          },
          "response": []
        },
        {
          "name": "Login (user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "if (body.user) pm.collectionVariables.set(\"currentUserId\", body.user.id);",
                  "// The refresh token is only sent as an httpOnly cookie. Postman stores the cookie and sends it",
                  "// automatically; it is also copied here for the \"Refresh (token in body)\" request.",
                  "const rt = pm.cookies.get(\"refreshToken\");",
                  "if (rt) pm.collectionVariables.set(\"refreshToken\", rt);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Needs a valid access token. Returns `TOKEN_EXPIRED` once it is older than 15 minutes; call Refresh then."
          },
          "response": []
        },
        {
          "name": "Refresh (cookie)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "if (body.user) pm.collectionVariables.set(\"currentUserId\", body.user.id);",
                  "// The refresh token is only sent as an httpOnly cookie. Postman stores the cookie and sends it",
                  "// automatically; it is also copied here for the \"Refresh (token in body)\" request.",
                  "const rt = pm.cookies.get(\"refreshToken\");",
                  "if (rt) pm.collectionVariables.set(\"refreshToken\", rt);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Uses the `refreshToken` cookie from login. Each call returns a new access token and replaces the cookie. Sending an old, already-used token returns `TOKEN_REUSED` and signs that session out."
          },
          "response": []
        },
        {
          "name": "Refresh (token in body)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jar = pm.cookies.jar();",
                  "const base = pm.collectionVariables.get(\"baseUrl\");",
                  "jar.unset(base + \"/api/auth\", \"refreshToken\", () => {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "if (body.user) pm.collectionVariables.set(\"currentUserId\", body.user.id);",
                  "// The refresh token is only sent as an httpOnly cookie. Postman stores the cookie and sends it",
                  "// automatically; it is also copied here for the \"Refresh (token in body)\" request.",
                  "const rt = pm.cookies.get(\"refreshToken\");",
                  "if (rt) pm.collectionVariables.set(\"refreshToken\", rt);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "For clients that cannot use cookies. The pre-request script deletes the refreshToken cookie from the Postman cookie jar, so the body token is the one used. (The server reads the cookie first when both are sent.)"
          },
          "response": []
        },
        {
          "name": "Change password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.accessToken) pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "if (body.user) pm.collectionVariables.set(\"currentUserId\", body.user.id);",
                  "// The refresh token is only sent as an httpOnly cookie. Postman stores the cookie and sends it",
                  "// automatically; it is also copied here for the \"Refresh (token in body)\" request.",
                  "const rt = pm.cookies.get(\"refreshToken\");",
                  "if (rt) pm.collectionVariables.set(\"refreshToken\", rt);",
                  "if (pm.response.code === 200) {",
                  "  const oldPw = pm.collectionVariables.get(\"userPassword\");",
                  "  pm.collectionVariables.set(\"userPassword\", pm.collectionVariables.get(\"newPassword\"));",
                  "  pm.collectionVariables.set(\"newPassword\", oldPw);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{userPassword}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/change-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "change-password"
              ]
            },
            "description": "Changes the password of the signed-in user (run **Login (user)** first). Signs out every other session and returns a new one. On success the script swaps `userPassword` and `newPassword`, so running it again changes the password back."
          },
          "response": []
        },
