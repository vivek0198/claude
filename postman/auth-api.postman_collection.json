      "value": "admin@example.com"
    },
    {
      "key": "userEmail",
      "value": "alice@example.com"
    },
    {
      "key": "unverifiedEmail",
      "value": "carol@example.com"
    },
    {
      "key": "password",
      "value": "Password123",
      "description": "Seed password for admin@ and carol@"
    },
    {
      "key": "userPassword",
      "value": "Password123",
      "description": "Password of userEmail; Change password / Reset password update it"
    },
    {
